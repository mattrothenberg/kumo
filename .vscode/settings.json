{
  "tailwindCSS.experimental.configFile": {
    "packages/kumo-docs/app/app.css": "packages/kumo-docs/app/**",
    "packages/kumo/src/styles/kumo-standalone.css": "packages/kumo/src/**"
  },
  "tailwindCSS.classFunctions": ["cn"],
  "files.associations": {
    "*.css": "tailwindcss",
    "**/wrangler*.jsonc": "jsonc"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "typescriptreact": "html",
    "javascriptreact": "html",
    "mdx": "html"
  }
}
