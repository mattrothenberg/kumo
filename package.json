{
  "name": "kumo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^24.11.1",
    "pnpm": ">=10.21.0"
  },
  "scripts": {
    "build": "pnpm --filter @cloudflare/kumo-docs build",
    "codegen": "pnpm --filter @cloudflare/kumo codegen",
    "build:all": "pnpm -r build",
    "changeset": "changeset",
    "clean": "pnpm -r exec rm -rf dist build .react-router .wrangler node_modules",
    "deploy": "pnpm --filter @cloudflare/kumo-docs deploy",
    "dev": "pnpm --filter @cloudflare/kumo-docs dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "pnpm --filter @cloudflare/kumo lint",
    "lockfile-check": "pnpm install --no-frozen-lockfile && git diff --exit-code pnpm-lock.yaml",
    "preview": "pnpm --filter @cloudflare/kumo-docs preview",
    "publish:beta": "bash ci/versioning/publish-beta.sh",
    "deploy:storybook-preview": "bash ci/versioning/deploy-storybook-preview.sh",
    "deploy:kumo-docs-preview": "bash ci/versioning/deploy-kumo-docs-preview.sh",
    "deploy:kumo-docs-astro-preview": "bash ci/versioning/deploy-kumo-docs-astro-preview.sh",
    "deploy:storybook-staging": "pnpm --filter @cloudflare/kumo build:storybook && pnpm --filter @cloudflare/kumo exec wrangler deploy --env staging",
    "deploy:kumo-docs-staging": "pnpm --filter @cloudflare/kumo-docs build && pnpm --filter @cloudflare/kumo-docs exec node scripts/prepare-staging-config.js && cd packages/kumo-docs/build/server && pnpm exec wrangler deploy",
    "ci:post-mr-report": "tsx ci/scripts/post-mr-report.ts",
    "release": "pnpm build:all && changeset publish",
    "release:beta": "changeset publish --no-git-tag --tag beta",
    "release:production": "bash ci/versioning/release-production.sh",
    "storybook": "pnpm --filter @cloudflare/kumo storybook",
    "kumo": "node packages/kumo/dist/cli/cli.js",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version",
    "version:beta": "./ci/versioning/version-beta.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@gitbeaker/rest": "^42.5.0",
    "@types/node": "catalog:",
    "lefthook": "2.0.12",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
