{
	"name": "kumo-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.11.1",
		"pnpm": ">=10.21.0"
	},
	"scripts": {
		"build": "pnpm --filter @cloudflare/kumo-docs build",
		"build:all": "pnpm -r build",
		"dev": "pnpm --filter @cloudflare/kumo-docs dev",
		"deploy": "pnpm --filter @cloudflare/kumo-docs deploy",
		"preview": "pnpm --filter @cloudflare/kumo-docs preview",
		"typecheck": "pnpm -r typecheck",
		"clean": "pnpm -r exec rm -rf dist build .react-router .wrangler node_modules",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"lint": "echo 'Linting not yet configured'"
	}
}
