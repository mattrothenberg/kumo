{
	"name": "@cloudflare/kumo",
	"version": "0.1.0",
	"private": false,
	"type": "module",
	"description": "Kumo - Cloudflare's component library for building modern web applications",
	"repository": {
		"type": "git",
		"url": "https://gitlab.cfdata.org/cloudflare/fe/kumo.git",
		"directory": "packages/kumo"
	},
	"license": "MIT",
	"keywords": [
		"react",
		"components",
		"ui",
		"cloudflare",
		"design-system"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/badge": {
			"types": "./dist/components/badge/index.d.ts",
			"import": "./dist/components/badge/index.js"
		},
		"./components/banner": {
			"types": "./dist/components/banner/index.d.ts",
			"import": "./dist/components/banner/index.js"
		},
		"./components/button": {
			"types": "./dist/components/button/index.d.ts",
			"import": "./dist/components/button/index.js"
		},
		"./components/calendar": {
			"types": "./dist/components/calendar/index.d.ts",
			"import": "./dist/components/calendar/index.js"
		},
		"./components/checkbox": {
			"types": "./dist/components/checkbox/index.d.ts",
			"import": "./dist/components/checkbox/index.js"
		},
		"./components/clipboard-text": {
			"types": "./dist/components/clipboard-text/index.d.ts",
			"import": "./dist/components/clipboard-text/index.js"
		},
		"./components/code": {
			"types": "./dist/components/code/index.d.ts",
			"import": "./dist/components/code/index.js"
		},
		"./components/combobox": {
			"types": "./dist/components/combobox/index.d.ts",
			"import": "./dist/components/combobox/index.js"
		},
		"./components/dialog": {
			"types": "./dist/components/dialog/index.d.ts",
			"import": "./dist/components/dialog/index.js"
		},
		"./components/dropdown": {
			"types": "./dist/components/dropdown/index.d.ts",
			"import": "./dist/components/dropdown/index.js"
		},
		"./components/expandable": {
			"types": "./dist/components/expandable/index.d.ts",
			"import": "./dist/components/expandable/index.js"
		},
		"./components/field": {
			"types": "./dist/components/field/index.d.ts",
			"import": "./dist/components/field/index.js"
		},
		"./components/input": {
			"types": "./dist/components/input/index.d.ts",
			"import": "./dist/components/input/index.js"
		},
		"./components/layer-card": {
			"types": "./dist/components/layer-card/index.d.ts",
			"import": "./dist/components/layer-card/index.js"
		},
		"./components/loader": {
			"types": "./dist/components/loader/index.d.ts",
			"import": "./dist/components/loader/index.js"
		},
		"./components/menubar": {
			"types": "./dist/components/menubar/index.d.ts",
			"import": "./dist/components/menubar/index.js"
		},
		"./components/meter": {
			"types": "./dist/components/meter/index.d.ts",
			"import": "./dist/components/meter/index.js"
		},
		"./components/pagination": {
			"types": "./dist/components/pagination/index.d.ts",
			"import": "./dist/components/pagination/index.js"
		},
		"./components/select": {
			"types": "./dist/components/select/index.d.ts",
			"import": "./dist/components/select/index.js"
		},
		"./components/surface": {
			"types": "./dist/components/surface/index.d.ts",
			"import": "./dist/components/surface/index.js"
		},
		"./components/switch": {
			"types": "./dist/components/switch/index.d.ts",
			"import": "./dist/components/switch/index.js"
		},
		"./components/tabs": {
			"types": "./dist/components/tabs/index.d.ts",
			"import": "./dist/components/tabs/index.js"
		},
		"./components/text": {
			"types": "./dist/components/text/index.d.ts",
			"import": "./dist/components/text/index.js"
		},
		"./components/toast": {
			"types": "./dist/components/toast/index.d.ts",
			"import": "./dist/components/toast/index.js"
		},
		"./components/tooltip": {
			"types": "./dist/components/tooltip/index.d.ts",
			"import": "./dist/components/tooltip/index.js"
		},
		"./blocks/breadcrumbs": {
			"types": "./dist/blocks/breadcrumbs/index.d.ts",
			"import": "./dist/blocks/breadcrumbs/index.js"
		},
		"./blocks/empty": {
			"types": "./dist/blocks/empty/index.d.ts",
			"import": "./dist/blocks/empty/index.js"
		},
		"./blocks/page-header": {
			"types": "./dist/blocks/page-header/index.d.ts",
			"import": "./dist/blocks/page-header/index.js"
		},
		"./layouts/resource-list": {
			"types": "./dist/layouts/resource-list/index.d.ts",
			"import": "./dist/layouts/resource-list/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./styles/tailwind": "./dist/styles/kumo.css",
		"./styles/standalone": "./dist/styles/kumo-standalone.css",
		"./styles": "./dist/styles/kumo.css",
		"./styles/*": "./dist/styles/*.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"*.css",
		"dist/styles/*.css"
	],
	"publishConfig": {
		"access": "restricted",
		"registry": "https://registry-gateway.cloudflare-ui.workers.dev"
	},
	"scripts": {
		"build": "vite build && tsx scripts/build-css.ts",
		"dev": "vite build --watch",
		"clean": "rm -rf dist",
		"lint": "oxlint src/** --type-aware",
		"prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test:run",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"new-component": "plop component",
		"new-block": "plop block",
		"new-layout": "plop layout",
		"validate:changeset": "tsx ../../ci/scripts/validate-kumo-changeset.ts"
	},
	"peerDependencies": {
		"@base-ui-components/react": "^1.0.0-beta.4",
		"@phosphor-icons/react": "^2.1.9",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^2.5.5"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.1.17",
		"@types/node": "^22.10.2",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitest/ui": "^2.1.9",
		"happy-dom": "^15.11.7",
		"oxlint": "1.28.0",
		"oxlint-tsgolint": "0.6.0",
		"plop": "4.0.4",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2",
		"vite": "^6.0.7",
		"vite-plugin-dts": "^4.3.0",
		"vitest": "^2.1.9"
	}
}
