    "dist/styles/*.css"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry-gateway.cloudflare-ui.workers.dev"
  },
  "scripts": {
    "prepare": "pnpm run prebuild",
    "build": "pnpm run prebuild && vite build --mode production && tsx scripts/build-css.ts && pnpm run build:cli",
    "build:cli": "tsx scripts/ai/build-cli.ts",
    "prebuild": "pnpm run build:primitives && pnpm run build:colors && pnpm run build:ai-metadata",
    "dev": "vite build --watch --mode development",
    "clean": "rm -rf dist",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "oxlint src/** --type-aware",
    "lint:eslint": "eslint src/",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test:unit",
    "typecheck": "tsc --noEmit",
    "test": "CI=true vitest run --project=unit",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:coverage": "vitest run --coverage",
    "new-component": "plop component",
    "new-block": "plop block",
    "new-layout": "plop layout",
    "validate:changeset": "tsx ../../ci/scripts/validate-kumo-changeset.ts",
    "build:colors": "tsx scripts/color/build-colors-storybook.ts",
    "figma:sync": "tsx scripts/figma/sync-tokens-to-figma.ts",
    "storybook": "pnpm run prebuild && storybook dev -p 6006",
    "build:storybook": "pnpm run prebuild && storybook build",
    "deploy": "pnpm run build:storybook && wrangler deploy",
    "deploy:ci": "CLOUDFLARE_ACCOUNT_ID=$CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_API_TOKEN=$CLOUDFLARE_API_TOKEN pnpm run build:storybook && wrangler deploy",
    "deploy-prod:ci": "pnpm run deploy:ci --branch main",
    "chromatic": "chromatic --exit-zero-on-changes",
    "build:ai-metadata": "tsx scripts/ai/component-registry.ts",
    "build:primitives": "tsx scripts/generate-primitives.ts",
    "validate:build": "vitest run --project=unit tests/imports/export-path-validation.test.ts"
  },
