---
import MainLayout from "./MainLayout.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  baseUIComponent?: string;
}

const { title, description, baseUIComponent } = Astro.props;
const baseUIUrl = baseUIComponent
  ? `https://base-ui.com/react/components/${baseUIComponent}`
  : null;
---

<MainLayout title={`${title} - Kumo`} description={description}>
  <div class="flex min-h-screen flex-col">
    <Header />

    <!-- Page Header -->
    <div
      class="border-b border-neutral-200 bg-surface-secondary pr-12 dark:border-neutral-800"
    >
      <div
        class="mx-auto border-r border-neutral-200 dark:border-neutral-800"
      >
        <div class="mx-auto max-w-5xl px-8 py-12">
          <h1 class="mb-3 text-4xl font-bold text-surface">{title}</h1>
          <p class="text-lg text-neutral-600 dark:text-neutral-400">
            {description}
          </p>
          {
            baseUIUrl && (
              <a
                href={baseUIUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1.5 text-sm text-blue-600 hover:text-blue-700 hover:underline dark:text-blue-400 dark:hover:text-blue-300"
              >
                <span>View Base UI documentation</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 256 256"
                  fill="currentColor"
                >
                  <path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Content -->
    <main class="flex grow flex-col pr-12">
      <div
        class="mx-auto w-full grow border-r border-neutral-200 dark:border-neutral-800"
      >
        <div class="mx-auto max-w-5xl px-8 py-12">
          <div class="prose prose-neutral dark:prose-invert max-w-none">
            <slot />
          </div>
        </div>
      </div>
    </main>
  </div>
</MainLayout>
