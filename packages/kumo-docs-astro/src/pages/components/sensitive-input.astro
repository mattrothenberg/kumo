---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { SensitiveInputDemo, SensitiveInputSizesDemo, SensitiveInputControlledDemo, SensitiveInputStatesDemo } from "../../components/demos/SensitiveInputDemo";
---

<DocLayout
  title="SensitiveInput"
  description="A masked input for sensitive values like API keys and secrets."
  sourceFile="components/sensitive-input"
  storybookPath="story/components-sensitiveinput"
>
  <ComponentSection>
    <ComponentExample code={`<SensitiveInput 
  label="API Key" 
  defaultValue="sk_live_abc123xyz789" 
/>`}>
      <SensitiveInputDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { SensitiveInput } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Sizes</h2>
    <p class="text-secondary mb-4">SensitiveInput supports multiple sizes to fit different contexts.</p>
    <ComponentExample code={`<SensitiveInput label="xs size" size="xs" defaultValue="secret-key" />
<SensitiveInput label="sm size" size="sm" defaultValue="secret-key" />
<SensitiveInput label="base size" size="base" defaultValue="secret-key" />
<SensitiveInput label="lg size" size="lg" defaultValue="secret-key" />`}>
      <SensitiveInputSizesDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Controlled</h2>
    <p class="text-secondary mb-4">Use controlled mode for full control over the input value.</p>
    <ComponentExample code={`const [value, setValue] = useState("my-secret-value");

<SensitiveInput
  label="Controlled Secret"
  value={value}
  onValueChange={setValue}
/>`}>
      <SensitiveInputControlledDemo client:load />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">States</h2>
    <p class="text-secondary mb-4">Various input states including error, disabled, read-only, and with description.</p>
    <ComponentExample code={`<SensitiveInput
  label="Error State"
  variant="error"
  defaultValue="invalid-key"
  error="This API key is not valid"
/>
<SensitiveInput
  label="Disabled"
  defaultValue="cannot-edit"
  disabled
/>
<SensitiveInput
  label="Read-only"
  defaultValue="view-only-secret-key"
  readOnly
/>
<SensitiveInput
  label="With Description"
  defaultValue="my-secret-value"
  description="Keep this value secure"
/>`}>
      <SensitiveInputStatesDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-neutral-600 dark:text-neutral-400">
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">label</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">value</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">size</td>
            <td class="px-4 py-3 font-mono text-xs">"xs" | "sm" | "base" | "lg"</td>
            <td class="px-4 py-3 font-mono text-xs">"base"</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">variant</td>
            <td class="px-4 py-3 font-mono text-xs">"default" | "error"</td>
            <td class="px-4 py-3 font-mono text-xs">"default"</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">description</td>
            <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">error</td>
            <td class="px-4 py-3 font-mono text-xs">string | object</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">disabled</td>
            <td class="px-4 py-3 font-mono text-xs">boolean</td>
            <td class="px-4 py-3 font-mono text-xs">false</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">readOnly</td>
            <td class="px-4 py-3 font-mono text-xs">boolean</td>
            <td class="px-4 py-3 font-mono text-xs">false</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
