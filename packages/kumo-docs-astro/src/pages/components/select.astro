---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { SelectBasicDemo } from "../../components/demos/SelectDemo";
---

<DocLayout
  title="Select"
  description="A dropdown select input for choosing from options."
  sourceFile="components/select"
  storybookPath="story/components-select"
  baseUIComponent="select"
>
  <ComponentSection>
    <ComponentExample code={`<Select renderValue={(v) => v || "Select..."}>
  <Select.Option value="opt1">Option 1</Select.Option>
  <Select.Option value="opt2">Option 2</Select.Option>
</Select>`}>
      <SelectBasicDemo client:load />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Select } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Usage</h2>
    <p class="mb-4 text-label">
      Select uses a compound component pattern:
    </p>
    <ul class="list-inside list-disc space-y-2 text-label">
      <li><code class="rounded bg-secondary px-1 py-0.5 text-sm">Select</code> - The select container</li>
      <li><code class="rounded bg-secondary px-1 py-0.5 text-sm">Select.Option</code> - Individual option items</li>
    </ul>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-label">
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">value</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">onValueChange</td>
            <td class="px-4 py-3 font-mono text-xs">(value: string) =&gt; void</td>
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">renderValue</td>
            <td class="px-4 py-3 font-mono text-xs">(value: string | null) =&gt; ReactNode</td>
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">disabled</td>
            <td class="px-4 py-3 font-mono text-xs">boolean</td>
            <td class="px-4 py-3 font-mono text-xs">false</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
