---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { LoaderBasicDemo, LoaderSizesDemo } from "../../components/demos/LoaderDemo";
---

<DocLayout
  title="Loader"
  description="A spinning loading indicator."
  sourceFile="components/loader"
  storybookPath="story/components-loader"
>
  <ComponentSection>
    <ComponentExample code={`<Loader />`}>
      <LoaderBasicDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Loader } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-6 text-2xl font-bold">Examples</h2>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Sizes</h3>
      <ComponentExample code={`<Loader size="sm" />
<Loader size="base" />
<Loader size="lg" />`}>
        <LoaderSizesDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-label">
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">size</td>
            <td class="px-4 py-3 font-mono text-xs">"sm" | "base" | "lg"</td>
            <td class="px-4 py-3 font-mono text-xs">"base"</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
