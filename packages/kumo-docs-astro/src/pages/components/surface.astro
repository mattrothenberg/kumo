---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { SurfaceDemo, SurfaceAsDemo, SurfaceNestedDemo } from "../../components/demos/SurfaceDemo";
---

<DocLayout
  title="Surface"
  description="A container component that provides a surface for content with proper styling."
  sourceFile="components/surface"
  storybookPath="story/components-surface"
>
  <ComponentSection>
    <ComponentExample code={`<Surface className="p-6 rounded-lg">
  <Text size="lg" weight="semibold">Surface Component</Text>
  <Text variant="secondary" className="mt-2">
    A container with consistent elevation and border styling.
  </Text>
</Surface>`}>
      <SurfaceDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Surface } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Polymorphic "as" prop</h2>
    <p class="text-label mb-4">Surface can render as different HTML elements using the `as` prop.</p>
    <ComponentExample code={`<Surface as="section" className="p-4 rounded-lg">
  <Text weight="medium">As section element</Text>
</Surface>
<Surface as="article" className="p-4 rounded-lg">
  <Text weight="medium">As article element</Text>
</Surface>
<Surface as="aside" className="p-4 rounded-lg">
  <Text weight="medium">As aside element</Text>
</Surface>`}>
      <SurfaceAsDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Nested Surfaces</h2>
    <p class="text-label mb-4">Surfaces can be nested to create layered interfaces.</p>
    <ComponentExample code={`<Surface className="p-6 rounded-lg">
  <Text weight="semibold">Outer Surface</Text>
  <Surface className="mt-4 p-4 rounded-md bg-surface-2">
    <Text variant="secondary">Nested Surface</Text>
  </Surface>
</Surface>`}>
      <SurfaceNestedDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-label">
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">as</td>
            <td class="px-4 py-3 font-mono text-xs">React.ElementType</td>
            <td class="px-4 py-3 font-mono text-xs">"div"</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">className</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">children</td>
            <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
