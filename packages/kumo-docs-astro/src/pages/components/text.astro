---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { TextVariantsDemo, TextSizesDemo } from "../../components/demos/TextDemo";
---

<DocLayout
  title="Text"
  description="Typography component for consistent text styling."
  sourceFile="components/text"
  storybookPath="story/components-text"
>
  <ComponentSection>
    <ComponentExample code={`<Text variant="heading1">Heading 1</Text>
<Text variant="body">Body text</Text>`}>
      <TextVariantsDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Text } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-6 text-2xl font-bold">Examples</h2>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Sizes</h3>
      <ComponentExample code={`<Text size="sm">Small size</Text>
<Text size="base">Base size</Text>
<Text size="lg">Large size</Text>`}>
        <TextSizesDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-label">
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">variant</td>
            <td class="px-4 py-3 font-mono text-xs">"heading1" | "heading2" | "heading3" | "body" | "secondary" | "mono"</td>
            <td class="px-4 py-3 font-mono text-xs">"body"</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">size</td>
            <td class="px-4 py-3 font-mono text-xs">"sm" | "base" | "lg"</td>
            <td class="px-4 py-3 font-mono text-xs">"base"</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">bold</td>
            <td class="px-4 py-3 font-mono text-xs">boolean</td>
            <td class="px-4 py-3 font-mono text-xs">false</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">as</td>
            <td class="px-4 py-3 font-mono text-xs">"span" | "p" | "h1" | "h2" | ...</td>
            <td class="px-4 py-3 font-mono text-xs">"span"</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
