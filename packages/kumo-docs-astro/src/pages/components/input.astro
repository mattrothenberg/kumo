---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import {
  InputBasicDemo,
  InputWithLabelDemo,
  InputErrorDemo,
  InputDisabledDemo,
} from "../../components/demos/InputDemo";
---

<DocLayout
  title="Input"
  description="A text input field for collecting user data."
  sourceFile="components/input"
  storybookPath="story/components-input"
  baseUIComponent="input"
>
  <!-- Demo -->
  <ComponentSection>
    <ComponentExample code={`<Input placeholder="Type something..." />`}>
      <InputBasicDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <!-- Installation -->
  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <h3 class="mb-2 text-lg font-semibold">Barrel</h3>
    <CodeBlock code={`import { Input } from "@cloudflare/kumo";`} lang="tsx" />
    <h3 class="mb-2 mt-4 text-lg font-semibold">Granular</h3>
    <CodeBlock
      code={`import { Input } from "@cloudflare/kumo/components/input";`}
      lang="tsx"
    />
  </ComponentSection>

  <!-- Examples -->
  <ComponentSection>
    <h2 class="mb-6 text-2xl font-bold">Examples</h2>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">With Label and Description</h3>
      <ComponentExample
        code={`<Input
  label="Email"
  placeholder="name@example.com"
  description="We'll never share your email."
/>`}
      >
        <InputWithLabelDemo client:visible />
      </ComponentExample>
    </div>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Error State</h3>
      <ComponentExample
        code={`<Input
  label="Email"
  placeholder="name@example.com"
  type="email"
  variant="error"
  error={{
    message: "Please enter a valid email.",
    match: "typeMismatch",
  }}
  description="The email to send notifications to."
/>`}
      >
        <InputErrorDemo client:visible />
      </ComponentExample>
    </div>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Disabled</h3>
      <ComponentExample code={`<Input placeholder="Disabled input" disabled />`}>
        <InputDisabledDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <!-- API Reference -->
  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-neutral-600 dark:text-neutral-400">
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">label</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">description</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">variant</td>
            <td class="px-4 py-3 font-mono text-xs">"default" | "error"</td>
            <td class="px-4 py-3 font-mono text-xs">"default"</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">error</td>
            <td class="px-4 py-3 font-mono text-xs"
              >{"{ message: string; match?: string }"}</td
            >
            <td class="px-4 py-3 font-mono text-xs">undefined</td>
          </tr>
          <tr class="border-b border-neutral-200 dark:border-neutral-800">
            <td class="px-4 py-3 font-mono text-xs">disabled</td>
            <td class="px-4 py-3 font-mono text-xs">boolean</td>
            <td class="px-4 py-3 font-mono text-xs">false</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
