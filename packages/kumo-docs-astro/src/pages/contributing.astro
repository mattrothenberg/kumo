---
import DocLayout from "../layouts/DocLayout.astro";
import ComponentSection from "../components/docs/ComponentSection.astro";
import CodeBlock from "../components/docs/CodeBlock.astro";
import Callout from "../components/docs/Callout.astro";
---

<DocLayout
  title="Contributing"
  description="Learn how to contribute to Kumo by adding new components and features."
>
  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Contributing to Kumo</h2>
    <p class="mb-4 text-neutral-600 dark:text-neutral-400">
      We welcome contributions to Kumo! This guide will help you get started
      with adding new components and blocks to the library.
    </p>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Components vs Blocks vs Layouts</h2>
    <div class="mb-4 grid gap-6 md:grid-cols-3">
      <div
        class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <h3 class="mb-2 text-lg font-semibold">Components</h3>
        <p class="mb-3 text-sm text-neutral-600 dark:text-neutral-400">
          Atomic, reusable UI elements
        </p>
        <ul
          class="list-inside list-disc space-y-1 text-sm text-neutral-700 dark:text-neutral-300"
        >
          <li>Single responsibility</li>
          <li>Highly reusable</li>
          <li>Minimal dependencies</li>
          <li>Style-focused</li>
        </ul>
        <p class="mt-3 text-xs text-neutral-500">
          Examples: Button, Input, Badge, Tabs
        </p>
      </div>
      <div
        class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <h3 class="mb-2 text-lg font-semibold">Blocks</h3>
        <p class="mb-3 text-sm text-neutral-600 dark:text-neutral-400">
          Composed patterns for page layouts
        </p>
        <ul
          class="list-inside list-disc space-y-1 text-sm text-neutral-700 dark:text-neutral-300"
        >
          <li>Compose multiple components</li>
          <li>Implement common patterns</li>
          <li>Layout-focused</li>
          <li>May include business logic</li>
        </ul>
        <p class="mt-3 text-xs text-neutral-500">
          Examples: Breadcrumbs, PageHeader, Empty
        </p>
      </div>
      <div
        class="rounded-lg border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <h3 class="mb-2 text-lg font-semibold">Layouts</h3>
        <p class="mb-3 text-sm text-neutral-600 dark:text-neutral-400">
          Page-level structure patterns
        </p>
        <ul
          class="list-inside list-disc space-y-1 text-sm text-neutral-700 dark:text-neutral-300"
        >
          <li>Full-page composition</li>
          <li>Consistent structure</li>
          <li>Responsive patterns</li>
          <li>Application-wide use</li>
        </ul>
        <p class="mt-3 text-xs text-neutral-500">
          Examples: ResourceListPage, DashboardPage
        </p>
      </div>
    </div>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Creating New Components</h2>
    <p class="mb-4 text-neutral-600 dark:text-neutral-400">
      Kumo includes a scaffolding tool that automates component creation. This
      ensures all components follow the same structure and are properly
      configured.
    </p>

    <h3 class="mb-3 mt-6 text-xl font-semibold">Run the Scaffolding Tool</h3>
    <p class="mb-4 text-neutral-600 dark:text-neutral-400">
      From the workspace root, run:
    </p>
    <CodeBlock
      code={`pnpm --filter @cloudflare/kumo new-component`}
      lang="bash"
    />

    <h3 class="mb-3 mt-6 text-xl font-semibold">For Blocks</h3>
    <CodeBlock code={`pnpm --filter @cloudflare/kumo new-block`} lang="bash" />

    <h3 class="mb-3 mt-6 text-xl font-semibold">For Layouts</h3>
    <CodeBlock code={`pnpm --filter @cloudflare/kumo new-layout`} lang="bash" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Development Workflow</h2>
    <div class="mb-6 grid gap-6 md:grid-cols-2">
      <div
        class="rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-blue-800 dark:bg-blue-950/30"
      >
        <h3 class="mb-2 text-lg font-semibold text-blue-900 dark:text-blue-100">
          Option 1: Storybook (Recommended)
        </h3>
        <p class="mb-3 text-sm text-blue-800 dark:text-blue-200">
          Best for isolated component development with instant feedback
        </p>
        <CodeBlock code={`pnpm storybook`} lang="bash" />
        <ul
          class="mt-3 list-inside list-disc space-y-1 text-sm text-blue-900 dark:text-blue-100"
        >
          <li>Full HMR with React Fast Refresh</li>
          <li>Changes reflect instantly</li>
          <li>Interactive component testing</li>
          <li>No build required</li>
        </ul>
      </div>

      <div
        class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <h3 class="mb-2 text-lg font-semibold">Option 2: Watch Build</h3>
        <p class="mb-3 text-sm text-neutral-600 dark:text-neutral-400">
          For testing components in the documentation site
        </p>
        <CodeBlock
          code={`# Terminal 1
pnpm --filter @cloudflare/kumo dev

# Terminal 2
pnpm --filter @cloudflare/kumo-docs dev`}
          lang="bash"
        />
      </div>
    </div>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Component Guidelines</h2>
    <ul
      class="list-inside list-disc space-y-2 text-neutral-700 dark:text-neutral-300"
    >
      <li>
        <strong>Accessibility</strong> - Include proper ARIA attributes and keyboard
        navigation
      </li>
      <li>
        <strong>TypeScript</strong> - Export prop types and use proper type annotations
      </li>
      <li>
        <strong>Styling</strong> - Use Tailwind CSS classes and the <code
          class="rounded bg-neutral-100 px-1 py-0.5 text-sm dark:bg-neutral-800"
          >cn</code
        > utility
      </li>
      <li>
        <strong>Consistency</strong> - Follow existing component patterns and naming
        conventions
      </li>
      <li>
        <strong>Documentation</strong> - Add clear JSDoc comments and usage examples
      </li>
      <li>
        <strong>Testing</strong> - Include unit tests for component behavior
      </li>
    </ul>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Additional Resources</h2>
    <ul
      class="list-inside list-disc space-y-2 text-neutral-700 dark:text-neutral-300"
    >
      <li>
        <a
          href="https://gitlab.cfdata.org/cloudflare/fe/kumo/"
          class="text-blue-600 hover:underline dark:text-blue-400"
          >Gitlab Repository</a
        >
      </li>
      <li>
        <a
          href="https://base-ui.com/"
          class="text-blue-600 hover:underline dark:text-blue-400"
          >Base UI Documentation</a
        >
      </li>
    </ul>
  </ComponentSection>
</DocLayout>
