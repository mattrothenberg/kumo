---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { BreadcrumbsDemo, BreadcrumbsWithIconsDemo, BreadcrumbsWithClipboardDemo, BreadcrumbsLoadingDemo, BreadcrumbsRootDemo } from "../../components/demos/BreadcrumbsDemo";
---

<DocLayout
  title="Breadcrumbs"
  description="A navigation component that shows the current page's location within a navigational hierarchy."
  sourceFile="blocks/breadcrumbs"
  storybookPath="story/blocks-breadcrumbs"
>
  <ComponentSection>
    <ComponentExample code={`<Breadcrumbs>
  <Breadcrumbs.Link icon={<HouseIcon size={16} />} href="/">
    Home
  </Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Link href="/docs">Projects</Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Current>Current Project</Breadcrumbs.Current>
</Breadcrumbs>`}>
      <BreadcrumbsWithIconsDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Breadcrumbs } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Usage</h2>
    <CodeBlock code={`import { Breadcrumbs } from "@cloudflare/kumo";

export default function Example() {
  return (
    <Breadcrumbs>
      <Breadcrumbs.Link href="/">Home</Breadcrumbs.Link>
      <Breadcrumbs.Separator />
      <Breadcrumbs.Link href="/docs">Docs</Breadcrumbs.Link>
      <Breadcrumbs.Separator />
      <Breadcrumbs.Current>Breadcrumbs</Breadcrumbs.Current>
    </Breadcrumbs>
  );
}`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-6 text-2xl font-bold">Examples</h2>

    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Basic</h3>
      <ComponentExample code={`<Breadcrumbs>
  <Breadcrumbs.Link href="#">Home</Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Link href="/docs">Docs</Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Current>Breadcrumbs</Breadcrumbs.Current>
</Breadcrumbs>`}>
        <BreadcrumbsDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Loading</h3>
      <ComponentExample code={`<Breadcrumbs>
  <Breadcrumbs.Link href="#" icon={<HouseIcon size={16} />}>
    Home
  </Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Link href="/docs">Docs</Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Current loading></Breadcrumbs.Current>
</Breadcrumbs>`}>
        <BreadcrumbsLoadingDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Root</h3>
      <ComponentExample code={`<Breadcrumbs>
  <Breadcrumbs.Current icon={<HouseIcon size={16} />}>
    Worker Analytics
  </Breadcrumbs.Current>
</Breadcrumbs>`}>
        <BreadcrumbsRootDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <div class="mb-12">
      <h3 class="mb-4 text-xl font-semibold">Clipboard</h3>
      <ComponentExample code={`<Breadcrumbs>
  <Breadcrumbs.Link href="#">Home</Breadcrumbs.Link>
  <Breadcrumbs.Separator />
  <Breadcrumbs.Current>Breadcrumbs</Breadcrumbs.Current>
  <Breadcrumbs.Clipboard text="#" />
</Breadcrumbs>`}>
        <BreadcrumbsWithClipboardDemo client:visible />
      </ComponentExample>
    </div>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    
    <div class="space-y-8">
      <div>
        <h3 class="mb-3 text-lg font-semibold">Breadcrumbs</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-semibold">Prop</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Default</th>
              </tr>
            </thead>
            <tbody class="text-label">
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">children</td>
                <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
                <td class="px-4 py-3 font-mono text-xs">required</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Breadcrumbs.Link</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-semibold">Prop</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Default</th>
              </tr>
            </thead>
            <tbody class="text-label">
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">children</td>
                <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
                <td class="px-4 py-3 font-mono text-xs">required</td>
              </tr>
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">href</td>
                <td class="px-4 py-3 font-mono text-xs">string</td>
                <td class="px-4 py-3 font-mono text-xs">required</td>
              </tr>
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">icon</td>
                <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
                <td class="px-4 py-3 font-mono text-xs">undefined</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Breadcrumbs.Current</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-semibold">Prop</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Default</th>
              </tr>
            </thead>
            <tbody class="text-label">
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">children</td>
                <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
                <td class="px-4 py-3 font-mono text-xs">required</td>
              </tr>
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">icon</td>
                <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
                <td class="px-4 py-3 font-mono text-xs">undefined</td>
              </tr>
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">loading</td>
                <td class="px-4 py-3 font-mono text-xs">boolean</td>
                <td class="px-4 py-3 font-mono text-xs">false</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Breadcrumbs.Separator</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-semibold">Prop</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Default</th>
              </tr>
            </thead>
            <tbody class="text-label">
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">-</td>
                <td class="px-4 py-3 font-mono text-xs">-</td>
                <td class="px-4 py-3 font-mono text-xs">-</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold">Breadcrumbs.Clipboard</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-4 py-3 text-left font-semibold">Prop</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Default</th>
              </tr>
            </thead>
            <tbody class="text-label">
              <tr class="border-b border-border">
                <td class="px-4 py-3 font-mono text-xs">text</td>
                <td class="px-4 py-3 font-mono text-xs">string</td>
                <td class="px-4 py-3 font-mono text-xs">required</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </ComponentSection>
</DocLayout>
