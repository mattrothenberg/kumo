---
import DocLayout from "../../layouts/DocLayout.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import { EmptyDemo, EmptySizesDemo, EmptyWithCommandDemo, EmptyWithActionsDemo, EmptyMinimalDemo } from "../../components/demos/EmptyDemo";
---

<DocLayout
  title="Empty"
  description="A placeholder component for empty states with customizable content."
  sourceFile="blocks/empty"
  storybookPath="story/blocks-empty"
>
  <ComponentSection>
    <ComponentExample code={`<Empty 
  icon={<Database size={48} className="text-disabled" />}
  title="No data available"
  description="There is no data to display at the moment. Try creating a new item to get started."
/>`}>
      <EmptyDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Installation</h2>
    <CodeBlock code={`import { Empty } from "@cloudflare/kumo";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Sizes</h2>
    <p class="text-label mb-4">Empty states come in three sizes to fit different container contexts.</p>
    <ComponentExample code={`<Empty size="sm" icon={...} title="..." description="..." />
<Empty size="base" icon={...} title="..." description="..." />
<Empty size="lg" icon={...} title="..." description="..." />`}>
      <EmptySizesDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">With Command Line</h2>
    <p class="text-label mb-4">Include a copyable command to help users get started.</p>
    <ComponentExample code={`<Empty 
  icon={<FolderOpen size={48} className="text-disabled" />}
  title="No projects found"
  description="Get started by creating your first project using the command below."
  commandLine="npm create kumo-project"
/>`}>
      <EmptyWithCommandDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">With Actions</h2>
    <p class="text-label mb-4">Add custom action buttons using the contents prop.</p>
    <ComponentExample code={`<Empty 
  icon={<CloudSlash size={48} className="text-disabled" />}
  title="No connection"
  description="Unable to connect to the server."
  contents={
    <div className="flex gap-2">
      <Button variant="primary">Retry</Button>
      <Button variant="secondary">Go Back</Button>
    </div>
  }
/>`}>
      <EmptyWithActionsDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">Minimal</h2>
    <p class="text-label mb-4">At minimum, only a title is required.</p>
    <ComponentExample code={`<Empty title="Nothing here" />`}>
      <EmptyMinimalDemo client:visible />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <h2 class="mb-4 text-2xl font-bold">API Reference</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 text-left font-semibold">Prop</th>
            <th class="px-4 py-3 text-left font-semibold">Type</th>
            <th class="px-4 py-3 text-left font-semibold">Default</th>
          </tr>
        </thead>
        <tbody class="text-label">
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">title</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">required</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">size</td>
            <td class="px-4 py-3 font-mono text-xs">"sm" | "base" | "lg"</td>
            <td class="px-4 py-3 font-mono text-xs">"base"</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">icon</td>
            <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">description</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">commandLine</td>
            <td class="px-4 py-3 font-mono text-xs">string</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
          <tr class="border-b border-border">
            <td class="px-4 py-3 font-mono text-xs">contents</td>
            <td class="px-4 py-3 font-mono text-xs">ReactNode</td>
            <td class="px-4 py-3 font-mono text-xs">-</td>
          </tr>
        </tbody>
      </table>
    </div>
  </ComponentSection>
</DocLayout>
