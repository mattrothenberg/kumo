---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import { HomeGrid } from "../components/demos/HomeGrid";
---

<MainLayout title="Kumo" description="Kumo – a modern component library">
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex grow flex-col pr-12">
      <div
        class="mx-auto w-full grow border-r border-neutral-200 dark:border-neutral-800"
      >
        <HomeGrid client:only="react" />
      </div>
    </main>
  </div>
</MainLayout>
