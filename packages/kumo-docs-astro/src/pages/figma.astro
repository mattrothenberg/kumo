---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import { FigmaPage } from "../components/demos/FigmaPage";
---

<MainLayout title="Figma Resources - Kumo" description="Figma design system resources for Kumo">
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex grow flex-col pr-12">
      <div
        class="mx-auto flex w-full grow items-center justify-center border-r border-neutral-200 dark:border-neutral-800"
      >
        <FigmaPage client:load />
      </div>
    </main>
  </div>
</MainLayout>
